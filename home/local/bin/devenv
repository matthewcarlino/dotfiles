install_lsp_php()
{
    local PHPACTOR_VER="2025.04.17.0"
    local PHPACTOR_DIR=$LOCAL_SRC/phpactor-$PHPACTOR_VER

    chklink "$LOCAL_BIN/phpactor" && return

    if [ ! -d "$PHPACTOR_DIR" ]; then
        echo -e "$INF Making directory: $PHPACTOR_DIR"
        mkdir -p $PHPACTOR_DIR
    fi

    if [ ! -f "$PHPACTOR_DIR/phpactor.phar" ]; then
        curl -Lo $PHPACTOR_DIR/phpactor.phar https://github.com/phpactor/phpactor/releases/download/$PHPACTOR_VER/phpactor.phar
    fi

    if [ ! -x "$PHPACTOR_DIR/phpactor.phar" ]; then
        chmod a+x $PHPACTOR_DIR/phpactor.phar
    fi

    symlink $PHPACTOR_DIR/phpactor.phar $LOCAL_BIN/phpactor
}

