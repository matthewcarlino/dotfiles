    local FZF_SRC="$LOCAL_SRC/fzf-git"
    local FZF_REPO="https://github.com/junegunn/fzf.git"
    local BUILD_TGT="$FZF_SRC/target"

    chklink "$LOCAL_BIN/fzf" && return

    if [ ! -d "$FZF_SRC" ]; then
        echo -e "$INF Cloning fzf"
        git clone $FZF_REPO $FZF_SRC
        cd $FZF_SRC
        git checkout $FZF_VER
        cd -
    fi

    if [ ! -d "$BUILD_TGT" ]; then
        echo -e "$INF Building fzf"
        cd $FZF_SRC
        make
        make install
        cd -
    fi

    symlink "$FZF_SRC/bin/fzf" "$LOCAL_BIN/fzf"
}

install_tool_rg()
{
    local RG_VER="master"
    local RG_SRC="$LOCAL_SRC/rg-git"
    local RG_REPO="https://github.com/BurntSushi/ripgrep.git"
    local BUILD_TGT="$RG_SRC/target/release"
    
    chklink "$LOCAL_BIN/rg" && return

    if [ ! -x "$(which cargo)" ]; then
        echo -e "$ERR No cargo! no rg!"
        return
    fi
    
    if [ ! -d "$RG_SRC" ]; then
        echo -e "$INF Cloning rg"
        git clone $RG_REPO $RG_SRC
    fi

    if [ ! -x "$BUILD_TGT/rg" ]; then
        echo "$INF Building rg"
        cd $RG_SRC
        cargo build --release
        cd -
    fi

    symlink "$BUILD_TGT/rg" "$LOCAL_BIN/rg"

}

install_tool_wez()
{
    local WEZ_VER="main"
    local WEZ_SRC="$LOCAL_SRC/wez-git"
    local WEZ_REPO="https://github.com/wezterm/wezterm.git"

    # first, lets check for X or wayland
    if [ -z "$(which Xorg 2> /dev/null)" -a -z "$(which wayland-scanner 2> /dev/null)" -a "Darwin" != "$(uname)" ]; then
        echo -e "$ERR No Xorg, no Wayland? No Wez"
        return
    fi

    chklink "$LOCAL_BIN/wezterm" && return

    if [ ! -x "$(which cargo)" ]; then
        echo -e "$ERR No cargo! no Wez!"
        return
    fi

    if [ ! -d "$WEZ_SRC" ]; then
        echo -e "$INF Cloning Wezterm"
        git clone --depth=1 --branch=$WEZ_VER --recursive $WEZ_REPO $WEZ_SRC
        cd $WEZ_SRC
        git submodule update --init --recursive
        cd -
    fi

    if [ ! -x "$LOCAL_SRC/wez-git/target/release/wezterm" ]; then
        echo -e "$INF Building wezterm"
        cd $WEZ_SRC
        cargo clean && cargo build --release
        cd -
    fi

    symlink $WEZ_SRC/target/release/wezterm $LOCAL_BIN/wezterm
}

install_tool_composer()
{
    local INST_DIR=$LOCAL_SRC/composer_installer
    local INST_BIN=$INST_DIR/installer
    local COMP_BIN=$LOCAL_BIN/composer

    chklink "$COMP_BIN" && return

    mkdir -p $INST_DIR
    cd $INST_DIR
    
    if [ ! -x "$INST_BIN" ]; then
	wget https://getcomposer.org/installer
    fi

    php $INST_BIN --install-dir=$LOCAL_BIN --filename=composer

    cd -
}

#
# Runtimes
#

install_rt_lua()
{
    local LUA_VER="5.4.7"
    local LUA_URL="https://www.lua.org/ftp/lua-$LUA_VER.tar.gz"
    local LUA_DIR="$LOCAL_SRC/lua-$LUA_VER"

    chklink "$LOCAL_BIN/lua" && return

    if [ ! -d "$LUA_DIR" ]; then
        cd $LOCAL_SRC
        curl -L -R -O $LUA_URL
        tar zxf lua-$LUA_VER.tar.gz
        cd - > /dev/null
        cd $LUA_DIR
        make
        make local
        cd - > /dev/null
    fi

    symlink $LUA_DIR/install/bin/lua $LOCAL_BIN/lua
    symlink $LUA_DIR/install/bin/luac $LOCAL_BIN/luac
}

install_rt_go()
{
    local GO_VER="go1.24.3"
    local GO_PKG="$GO_VER.$(uname | tr '[:upper:]' '[:lower:]')-$(uname -m | sed 's/x86_64/amd64/').tar.gz"
    local GO_URL="https://go.dev/dl/$GO_PKG"

    # Check if the bin is executable
    chklink "$LOCAL_BIN/go" && return

    cd $LOCAL_SRC
    # Look for a local src
    if [ ! -d "$GO_VER" ]; then
        if [ ! -f  $GO_PKG ]; then
            echo -e "$INF Downloading $GO_PKG"
            curl -L -R -O $GO_URL
        fi
        echo -e "$INF Extracting $GO_PKG"
        tar -xf $GO_PKG
        mv ./go ./$GO_VER
    fi
    cd - > /dev/null

    symlink $LOCAL_SRC/$GO_VER/bin/go $LOCAL_BIN/go
    symlink $LOCAL_SRC/$GO_VER/bin/go $LOCAL_BIN/go

}

install_rt_rust()
{
    local RUSTUP_BIN="$HOME/.cargo/bin/rustup"

    if [ ! -x "$RUSTUP_BIN" ]; then
        echo -e "$INF Installing rust"
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- --no-modify-path -y
    else
        echo -e "$CHK rust found! All good here!"
    fi
}

install_rt_ocaml()
{
    echo -e "$INF TODO: Ocaml runtime"
}

install_rt_deno()
{
    # depends on cargo, cmake, protobuf-compiler, libglib2.0-dev, https://apt.llvm.org/llvm.sh
    chklink "$LOCAL_BIN/deno" && return 

    if [ ! -d "$LOCAL_SRC/deno-git" ]; then
        echo -e "$INF Cloning deno"
        git clone --recurse-submodules https://github.com/denoland/deno.git $LOCAL_SRC/deno-git
    fi

    if [ ! -x "$(which cargo)" ]; then
        echo -e "$ERR No cargo! no deno!"
        return
    fi

    if [ ! -x "$LOCAL_SRC/deno-git/target/release/deno" ]; then
        echo -e "$INF Building deno"
        cd $LOCAL_SRC/deno-git
        cargo clean && cargo build --release
        cd -
    fi

    symlink $LOCAL_SRC/deno-git/target/release/deno $LOCAL_BIN/deno
}

install_rt_nvm()
{
    local NVM_SRC="$LOCAL_SRC/nvm-git"

    chklink "$LOCAL_BIN/nvm" && return

    if [ ! -d "$NVM_SRC" ]; then
        echo -e "$INF Cloning nvm"
        git clone https://github.com/nvm-sh/nvm.git $NVM_SRC
    fi

    symlink $NVM_SRC/nvm-exec $LOCAL_BIN/nvm
    symlink $NVM_SRC/nvm.sh $LOCAL_BIN/nvm.sh
}

install_rt_ts()
{
    local TS_PKG="typescript"
    local TS_BIN="tsc"
    local TSSERV_BIN="tsserver"
    local TS_BINDIR="$LOCAL_LIB/node_modules/typescript/bin"

    chklink "$LOCAL_BIN/$TS_BIN" \
        && chklink "$LOCAL_BIN/$TSSERV_BIN" \
        && return

    if [ -z "$(npm --prefix=$HOME/.local ls -g --parseable $TS_PKG)" ]; then
        echo -e "$INF Installing $TS_PKG"
        npm --prefix=$HOME/.local i -g $TS_PKG
    fi

}

install_rt_php()
{
    # Depends on pkg-config build-essential autoconf bison re2c libxml2-dev libsqlite3-dev
    # oniguruma for mbstring

    local PHP_VER="php-8.4.7"
    local PHP_REPO="https://github.com/php/php-src.git"
    local PHP_SRC="$LOCAL_SRC/php-git"
    local BUILD_TGT="$PHP_SRC/target"
    local PHP_INI="$BUILD_TGT/lib/php.ini"

    # chklink "$LOCAL_BIN/php" && return

    if [ ! -d "$PHP_SRC" ]; then
        echo -e "$INF Cloning php"
        git clone $PHP_REPO $PHP_SRC
        cd $PHP_SRC
        git checkout $PHP_VER
        cd -
    fi

    if [ ! -s "$PHP_SRC/configure" ]; then
        echo -e "$INF Generating php configure"
        cd $PHP_SRC
        ./buildconf --force
        cd -
    fi

    # if [ ! -s "$PHP_SRC/config.status" ]; then
        echo -e "$INF Configuring php for build"
        cd $PHP_SRC
        ./configure --prefix=$BUILD_TGT --exec-prefix=$BUILD_TGT \
            --without-sqlite3 \
            --without-pdo-sqlite \
            --enable-fpm \
            --with-openssl \
            --enable-exif \
            --enable-intl \
            --with-pear \
            --with-mysqli \
            --enable-gd \
            --enable-ftp \
            --with-zip \
            --with-zlib \
            --with-curl \
            --enable-mbstring \
	    --disable-mbregex
            # --with-iconv=/opt/homebrew/opt/libiconv
            # --with-pgsql
        cd -
    # fi
    
    # if [ ! -d "$BUILD_TGT" ]; then
        echo -e "$INF Building php"
        cd $PHP_SRC
        make
        make install
        cd -
    # fi
    
    if [ ! -s "$PHP_INI" ]; then
        echo -e "$INF Copying php.ini"
        cd $PHP_SRC
        cp php.ini-development $PHP_INI
        sed -i '0,/^;include_path/s|^;include_path = .*|include_path = "/home/${USER}/.local/lib/php:/home/${USER}/.local/include/php"|' "$PHP_INI"
        cd -
    fi

    symlink $BUILD_TGT/lib/php $LOCAL_LIB/php
    symlink $BUILD_TGT/include/php $LOCAL_INC/php

    symlink $BUILD_TGT/bin/php $LOCAL_BIN/php
    symlink $BUILD_TGT/bin/phpize $LOCAL_BIN/phpize
    symlink $BUILD_TGT/bin/pecl $LOCAL_BIN/pecl
    symlink $BUILD_TGT/bin/phar $LOCAL_BIN/phar
    symlink $BUILD_TGT/sbin/php-fpm $LOCAL_SBIN/php-fpm
    
}

