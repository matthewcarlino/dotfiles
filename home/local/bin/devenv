#!/bin/bash

# Location for tool source (when going that route)
LOCAL_SRC=$HOME/.local/src
LOCAL_BIN=$HOME/.local/bin
LOCAL_SBIN=$HOME/.local/sbin
LOCAL_LIB=$HOME/.local/lib
LOCAL_INC=$HOME/.local/include
CHK="\033[32m\u2714\033[0m"
INF="\033[34m\u2139\033[0m"
ERR="\033[31m\u2718\033[0m"

# General setup
make_dirs()
{
    if [ ! -d "$LOCAL_SRC" ]; then
        echo -e "$INF Making directory: $LOCAL_SRC"
        mkdir -p $LOCAL_SRC
    fi

    if [ ! -d "$LOCAL_BIN" ]; then
        echo -e "$INF Making directory: $LOCAL_BIN"
        mkdir -p $LOCAL_BIN
    fi
    
    if [ ! -d "$LOCAL_SBIN" ]; then
        echo -e "$INF Making directory: $LOCAL_SBIN"
        mkdir -p $LOCAL_SBIN
    fi

    if [ ! -d "$LOCAL_LIB" ]; then
        echo -e "$INF Making directory: $LOCAL_LIB"
        mkdir -p $LOCAL_LIB
    fi

    if [ ! -d "$LOCAL_INC" ]; then
        echo -e "$INF Making directory: $LOCAL_INC"
        mkdir -p $LOCAL_INC
    fi
}

# Make a symlink, but check if it exists first
# $1 - The real thing
# $2 - Link name
symlink()
{
    local linkname="$(readlink $2)"
    if [ "$1" != "$linkname" ]; then
        rm $2 2> /dev/null
        echo -e "$INF Making symlink: $(basename $2)"
        ln -snvf "$1" "$2"
    fi
}

chklink()
{
    if [ -x "$1" ]; then
        echo -e "$CHK $(basename $1) found! All good here!"
        return 0
    fi

    return 1
}

remlink()
{
    if [ -L "$1" ]; then
        echo -e "$INF Removing defunct $(basename $1) link"
    fi
}

#
# Tools
#

install_tool_git()
{
    # Just be normal
    echo "$ERR Git install not implemented"
}

install_tool_vim()
{
    local VIM_VER="v9.1.1406"
    local VIM_SRC="$LOCAL_SRC/vim-git"
    local VIM_REPO="https://github.com/vim/vim.git"
    local BUILD_TGT="$VIM_SRC/target"
    
    chklink "$LOCAL_BIN/vim" && return
    

    if [ ! -d "$VIM_SRC" ]; then
        echo -e "$INF Cloning vim"
        git clone $VIM_REPO $VIM_SRC
        cd $VIM_SRC
        git checkout $VIM_VER
        cd -
    fi

    if [ ! -d "$BUILD_TGT" ]; then
        echo -e "$INF Building vim"
        cd $VIM_SRC
        ./configure --prefix=$BUILD_TGT --exec-prefix=$BUILD_TGT
        make
        make install
        cd -
    fi

    if [ ! -d "$HOME/.vim/tmp" ]; then
        echo -e "$INF making vim temp dirs"
        mkdir -p $HOME/.vim/tmp/swap $HOME/.vim/tmp/backup $HOME/.vim/tmp/undo
    fi

    symlink "$BUILD_TGT/bin/vim" "$LOCAL_BIN/vim"
}

install_tool_nvim()
{
    local NVIM_VER="v0.11.1"
    local NVIM_SRC="$LOCAL_SRC/nvim-git"
    local NVIM_REPO="https://github.com/neovim/neovim.git"
    local BUILD_TGT="$NVIM_SRC/build/target"
    
    chklink "$LOCAL_BIN/nvim" && return
    

    if [ ! -d "$NVIM_SRC" ]; then
        echo -e "$INF Cloning nvim"
        git clone $NVIM_REPO $NVIM_SRC
        cd $NVIM_SRC
        git checkout $NVIM_VER
        cd -
    fi

    if [ ! -d "$BUILD_TGT" ]; then
        echo -e "$INF Building nvim"
        cd $NVIM_SRC
        make CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=$BUILD_TGT"
        make install
        cd -
    fi

    symlink "$BUILD_TGT/bin/nvim" "$LOCAL_BIN/nvim"
}

